# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อมจริง
# .env อยู่ใน .gitignore แล้ว ห้าม commit ค่าจริงเข้า repo (LOT-60)

# ฐานข้อมูล — ค่านี้ตรงกับ docker-compose.yml สำหรับ development เท่านั้น
DATABASE_URL="postgresql://lottery:lottery_dev_only@127.0.0.1:5433/lottery?schema=public"

# Integration test ใช้ schema แยกและมี safety guard ไม่ให้ล้างข้อมูล development
TEST_DATABASE_URL="postgresql://lottery:lottery_dev_only@127.0.0.1:5433/lottery?schema=integration_test"

# ความยาวอายุ session หน่วยเป็นนาที
SESSION_TTL_MINUTES=480

# ชื่อ cookie ที่เก็บ session token
SESSION_COOKIE_NAME=lottery_session

# ตั้งเป็น production บน staging และ production จริง เพื่อบังคับ Secure cookie
NODE_ENV=development

# Token สำหรับ scheduler เรียก POST /api/jobs/cutoff
# ไม่ตั้งค่า = ปิด endpoint นั้นไว้ (ตอบ 503) ซึ่งปลอดภัยกว่าเปิดทิ้งไว้
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CUTOFF_JOB_TOKEN=

# รหัสผ่านเริ่มต้นของบัญชีที่ seed สร้าง ใช้กับ development เท่านั้น
# ทุกบัญชีถูกตั้ง mustChangePassword = true จึงต้องเปลี่ยนทันทีที่ login ครั้งแรก
SEED_PASSWORD=devpassword123
# false ใช้เฉพาะเครื่องสาธิตที่ต้องการเข้าระบบทันที
SEED_MUST_CHANGE_PASSWORD=true

# Private Object Storage — Development ใช้ MinIO จาก docker-compose.yml
# Production เปลี่ยน STORAGE_PROVIDER=s3 และใช้ Credential จาก Secret Manager หรือ IAM Role
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bill-private
STORAGE_ACCESS_KEY=minio_dev_only
STORAGE_SECRET_KEY=minio_dev_secret_only
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=300

# จำกัดรวมทุกประเภทต่อหนึ่งบิล และบังคับหลักฐานการสั่งซื้อก่อนยืนยันบิล
ATTACHMENT_MAX_FILE_SIZE_MB=5
ATTACHMENT_MAX_FILES_PER_BILL=5
ATTACHMENT_MAX_IMAGE_PIXELS=40000000
BILL_ORDER_EVIDENCE_REQUIRED=true
# เปิดเป็น true เมื่อองค์กรกำหนดว่าทุกบิลต้องมีหลักฐานการชำระเงิน
BILL_PAYMENT_EVIDENCE_REQUIRED=false

# Owner AI Assistant — เรียกจาก Server เท่านั้น ห้ามใช้ NEXT_PUBLIC_ นำหน้า
# สร้างคีย์จาก OpenTyphoon และเก็บค่าจริงไว้ใน .env หรือ Secret Manager
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TIMEOUT_MS=45000
TYPHOON_MAX_COMPLETION_TOKENS=1024

# เวลารอ API ผลรางวัลของสำนักงานสลากกินแบ่งรัฐบาล (มิลลิวินาที)
GLO_API_TIMEOUT_MS=15000

# แจ้งเตือนผ่าน Telegram — เรียกจาก Server เท่านั้น ห้ามใช้ NEXT_PUBLIC_ นำหน้า
# 1. สร้างบอทกับ @BotFather ด้วยคำสั่ง /newbot แล้วเก็บโทเค็นที่ได้
# 2. ทักบอทหนึ่งข้อความ (หรือเชิญเข้ากลุ่มแล้วพิมพ์อะไรก็ได้)
# 3. เปิด https://api.telegram.org/botTOKEN/getUpdates แล้วอ่านค่า chat.id
#    แทนคำว่า TOKEN ด้วยโทเค็นจริง ต่อติดกับคำว่า bot ห้ามเว้นวรรคและห้ามใส่วงเล็บ < >
#    ตัวอย่าง https://api.telegram.org/bot123456789:AAxxxxx/getUpdates
#    ถ้าได้ 404 Not Found แปลว่าโทเค็นผิดหรือมีวงเล็บติดมา ไม่ใช่ปัญหา chat id
# 4. ใส่ค่าจริงใน .env ไม่ใช่ในไฟล์นี้ แล้วตรวจด้วย npm run notify:check
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=15000

# ห้องแยกในกลุ่ม (Telegram Topics) — เว้นว่างได้ จะส่งเข้าห้องรวมของกลุ่มแทน
# ต้องเปิด Topics ในกลุ่มก่อน ซึ่งจะอัปเกรดกลุ่มเป็น supergroup
# และทำให้ TELEGRAM_CHAT_ID เปลี่ยนเป็นเลขขึ้นต้น -100 ต้องหาใหม่ด้วย
# วิธีหาเลขห้อง: พิมพ์ข้อความในห้องนั้น แล้วอ่าน message_thread_id จาก getUpdates
TELEGRAM_TOPIC_DAILY_SUMMARY=
TELEGRAM_TOPIC_EVIDENCE=

# ใช้ทำลิงก์กลับเข้าระบบในข้อความแจ้งเตือน
APP_BASE_URL=http://localhost:3000

# token ของ job แจ้งเตือน แยกจาก CUTOFF_JOB_TOKEN เพราะเป็นคนละอำนาจ
# ไม่ตั้ง = ปิด endpoint /api/jobs/notify (ยังรันด้วย npm run job:notify ได้)
NOTIFY_JOB_TOKEN=

# ความถี่ของโหมดเฝ้าดู (npm run job:notify:watch) หน่วยวินาที ขั้นต่ำ 10
NOTIFY_WATCH_INTERVAL_SECONDS=60
