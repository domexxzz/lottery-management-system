        </mxCell>
        <mxCell id="subtitle" value="ตั้งค่าระบบ → รับบิล → ปิดรับ → กรอกและตรวจผล → คำนวณ → กระทบยอด → ปิดบัญชี → วิเคราะห์และตรวจสอบย้อนหลัง" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Tahoma;fontSize=14;fontColor=#617786;" vertex="1" parent="1">
          <mxGeometry x="32" y="65" width="1450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="สีฟ้า = ตั้งค่าและบิล&#160;&#160;&#160; สีเหลือง = ผลรางวัล&#160;&#160;&#160; สีม่วง = Settlement&#160;&#160;&#160; สีเขียว = รายงานและตรวจสอบ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F7FAFB;strokeColor=#D8E4E8;fontFamily=Tahoma;fontSize=12;fontColor=#526C7A;arcSize=20;" vertex="1" parent="1">
