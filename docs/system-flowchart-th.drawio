        <mxCell id="title" value="ระบบบริหารจัดการลอตเตอรี่ — Flowchart ภาพรวมทั้งหมด" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Tahoma;fontSize=28;fontStyle=1;fontColor=#0D3148;" vertex="1" parent="1">
