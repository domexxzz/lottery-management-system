        <mxCell id="res2" value="Checker ตรวจผล&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;เทียบเลข ผู้กรอก และเวลา&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#D5A93C;fontColor=#70520F;fontFamily=Tahoma;fontSize=13;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1015" y="315" width="220" height="70" as="geometry" /></mxCell>
