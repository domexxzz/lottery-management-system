        <mxCell id="st5" value="SETTLED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;คำนวณแล้ว&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6F7;strokeColor=#9B82BC;fontColor=#543E73;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="940" y="705" width="145" height="55" as="geometry" /></mxCell>
        <mxCell id="st6" value="RECONCILED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;กระทบยอดครบ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F6EC;strokeColor=#61AB7F;fontColor=#216444;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1120" y="705" width="145" height="55" as="geometry" /></mxCell>
