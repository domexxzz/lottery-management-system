        <mxCell id="set3" value="สรุปต่อ Agent&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ยอดขาย / รางวัล / คอม / สุทธิ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAF8;strokeColor=#9D84BF;fontColor=#533E73;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1325" y="385" width="180" height="72" as="geometry" /></mxCell>
        <mxCell id="set4" value="Admin กระทบยอด&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ยืนยันยอดจริงทีละ Agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DEF4;strokeColor=#8768AF;fontColor=#4B3569;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1535" y="385" width="180" height="72" as="geometry" /></mxCell>
        <mxCell id="set5" value="ครบทุก Agent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDE4F7;strokeColor=#8060AA;fontColor=#4B3569;fontFamily=Tahoma;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="490" width="130" height="90" as="geometry" /></mxCell>
        <mxCell id="set6" value="Owner อนุมัติและปิดบัญชี&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;รอบเสร็จสมบูรณ์ แก้ไขไม่ได้&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E7;strokeColor=#4EA474;fontColor=#1F6444;fontFamily=Tahoma;fontSize=13;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1485" y="610" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="formula" value="สุทธิ = ยอดขาย − จ่ายรางวัล − คอมมิชชัน&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;บวก = Agent นำส่ง / ลบ = กิจการจ่ายส่วนต่าง&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7B6DB;dashed=1;fontColor=#65517F;fontFamily=Tahoma;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1315" y="500" width="220" height="75" as="geometry" /></mxCell>

        <mxCell id="status_title" value="สถานะของรอบและบิล" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=14;fontStyle=1;fontColor=#284B60;" vertex="1" parent="1"><mxGeometry x="30" y="715" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="st1" value="DRAFT&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ร่างบิล&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D2;strokeColor=#D6AE4B;fontColor=#76560F;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="220" y="705" width="145" height="55" as="geometry" /></mxCell>
        <mxCell id="st2" value="CONFIRMED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ยืนยันแล้ว&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F4F5;strokeColor=#69AEB4;fontColor=#1D6169;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="400" y="705" width="145" height="55" as="geometry" /></mxCell>
        <mxCell id="st3" value="LOCKED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ปิดรับแล้ว&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2F8;strokeColor=#79A4C0;fontColor=#315F7C;fontFamily=Tahoma;fontSize=12;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="580" y="705" width="145" height="55" as="geometry" /></mxCell>
