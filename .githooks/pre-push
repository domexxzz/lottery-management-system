#!/bin/sh
#
# กันโค้ดที่ยังไม่ผ่านการตรวจขึ้น main
#
# ⚠️ นี่ไม่ใช่ branch protection ของจริง
#    - ทำงานเฉพาะบนเครื่องที่ตั้ง core.hooksPath ไว้แล้ว
#    - ข้ามได้ด้วย git push --no-verify
#    - ไม่ได้บังคับกับคนอื่นในทีม
#
#    ของจริงต้องตั้งที่ GitHub ซึ่ง private repo ต้องใช้แผน Pro ขึ้นไป
#    ดูหัวข้อ "การป้องกัน main" ใน docs/DEPLOYMENT.md
#
# เปิดใช้งาน: git config core.hooksPath .githooks

protected_branch="main"
checks_run=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    "refs/heads/$protected_branch")
      if [ "$checks_run" -eq 0 ]; then
        echo "pre-push: กำลังตรวจก่อนขึ้น $protected_branch"

        if ! npx tsc --noEmit; then
          echo "pre-push: type check ไม่ผ่าน — ยกเลิกการ push" >&2
          exit 1
        fi

        if ! npx vitest run; then
          echo "pre-push: unit test ไม่ผ่าน — ยกเลิกการ push" >&2
          exit 1
        fi

        echo "pre-push: ผ่าน · next build จะถูกตรวจอีกครั้งใน CI"
        checks_run=1
      fi
      ;;
  esac
done

exit 0
